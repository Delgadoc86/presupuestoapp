rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Admin check: el doc admins/{uid} existe → el usuario es admin.
    // Nota: esta función hace una lectura extra por request; es aceptable
    // dado el volumen actual de la app.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Colecciones ───────────────────────────────────────────────────────────

    // users/{uid}
    // Cada usuario lee/escribe su propio doc.
    // Admin puede leer y escribir docs de cualquier usuario (gestión de planes).
    match /users/{uid} {
      allow read:  if isSignedIn() && (isOwner(uid) || isAdmin());
      allow write: if isSignedIn() && (isOwner(uid) || isAdmin());
    }

    // businessProfiles/{uid}
    // Solo el propio usuario puede escribir su perfil. Admin puede leer.
    match /businessProfiles/{uid} {
      allow read:  if isSignedIn() && (isOwner(uid) || isAdmin());
      allow write: if isSignedIn() && isOwner(uid);
    }

    // quotes/{quoteId}
    // Acceso restringido al usuario dueño del presupuesto.
    match /quotes/{quoteId} {
      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // templates/{templateId}
    // Acceso restringido al usuario dueño de la plantilla.
    match /templates/{templateId} {
      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // admins/{uid}
    // Solo lectura para usuarios autenticados (para verificar si son admin).
    // Escritura solo desde Firebase Console — nunca desde la app.
    match /admins/{uid} {
      allow read:  if isSignedIn();
      allow write: if false;
    }
  }
}
