rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers generales ──────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function accountAllowsWrites() {
      return isVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('deletionPending', false) == false;
    }

    // Admin check: el doc admins/{uid} existe → el usuario es admin.
    function isAdmin() {
      return isVerified()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Helpers de negocio para users/{uid} ────────────────────────────────

    // Debe coincidir MANUALMENTE con APP_CONFIG.demoQuoteLimit (src/config/appConfig.js).
    // En la práctica quoteLimit siempre viene seteado explícito desde registerWithEmail,
    // así que este default solo cubre documentos legacy sin el campo.
    function demoQuoteLimitDefault() { return 3; }

    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }

    // UTC por defecto (Timestamp.year()/.month() sin argumento de zona horaria).
    // dateUtils.js:getCurrentYearMonth() calcula en UTC para coincidir exactamente.
    function currentYearMonth() {
      return string(request.time.year()) + '-' + pad2(request.time.month());
    }

    function isProActive(userData) {
      return userData.get('pro', false) == true &&
        (!('proExpiresAt' in userData) || userData.proExpiresAt == null
          || userData.proExpiresAt > request.time);
    }

    function effectiveQuotesThisMonth(userData) {
      return userData.get('quoteMonth', '') == currentYearMonth()
        ? userData.get('quotesThisMonth', 0) : 0;
    }

    function planFields()    { return ['planType','pro','enabled','quoteLimit','proExpiresAt',
                                        'proActivatedAt','proRemainingDays','planUpdatedAt','suspendedAt']; }
    function usageFields()   { return ['lastQuoteNumber','totalQuotes','quotesThisMonth','quoteMonth']; }
    function profileFields() { return ['businessName','ownerName','onboardingComplete']; }

    function createFieldsAllowed() {
      return ['email','createdAt','onboardingComplete','lastQuoteNumber',
              'planType','pro','enabled','quoteLimit',
              'quotesThisMonth','quoteMonth','totalQuotes'];
    }

    // ── Helpers de negocio para clients/{clientId} ─────────────────────────

    function isNullableString(v) { return v == null || v is string; }

    function clientFieldsAllowed() {
      return ['userId','name','phone','email','address','notes',
              'archived','archivedAt','createdAt','updatedAt'];
    }

    function businessProfileFieldsAllowed() {
      return ['ownerName','businessName','sector','whatsapp','email','address','cuit',
              'generalConditions','validityDays','logoUrl','updatedAt'];
    }

    function businessProfileValid(data) {
      return data.keys().hasOnly(businessProfileFieldsAllowed())
        && data.get('ownerName', '') is string
        && data.get('ownerName', '').size() > 0
        && data.get('ownerName', '').size() <= 120
        && data.get('businessName', '') is string
        && data.get('businessName', '').size() <= 120
        && data.get('sector', '') is string
        && data.get('sector', '').size() > 0
        && data.get('sector', '').size() <= 120
        && data.get('whatsapp', '') is string
        && data.get('whatsapp', '').size() > 0
        && data.get('whatsapp', '').size() <= 40
        && data.get('email', '') is string
        && data.get('email', '').size() <= 254
        && data.get('address', '') is string
        && data.get('address', '').size() <= 300
        && data.get('cuit', '') is string
        && data.get('cuit', '').size() <= 30
        && data.get('generalConditions', '') is string
        && data.get('generalConditions', '').size() <= 5000
        && data.get('validityDays', 30) is int
        && data.get('validityDays', 30) >= 1
        && data.get('validityDays', 30) <= 365
        && isNullableString(data.get('logoUrl', null))
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // ¿clientId referencia un cliente propio del usuario? Usada tanto en la
    // creación como en la edición de quotes. No exige archived == false a
    // propósito: un presupuesto ya vinculado a un cliente archivado debe
    // poder seguir editándose sin quedar bloqueado.
    function referencesOwnClient(clientId) {
      return clientId is string
        && exists(/databases/$(database)/documents/clients/$(clientId))
        && get(/databases/$(database)/documents/clients/$(clientId)).data.userId == request.auth.uid;
    }

    function isNullableTimestamp(v) { return v == null || v is timestamp; }

    // Campo de fecha asociado a cada estado (null si ese estado no tiene una
    // fecha de seguimiento propia — draft y paid). Debe coincidir MANUALMENTE
    // con TRACKING_DATE_FIELD de src/utils/quoteStatus.js. Se usa .get() con
    // default sobre un map literal en vez de una cadena de ternarios: el
    // compilador de reglas advertía "tipos distintos" (string vs null) en
    // los dos lados de un ternario encadenado.
    function trackingDateForStatus(status) {
      return {
        'sent': 'sentAt', 'accepted': 'acceptedAt', 'rejected': 'rejectedAt', 'expired': 'expiredAt'
      }.get(status, null);
    }

    function trackingDatesValid(data) {
      return isNullableTimestamp(data.get('sentAt', null))
        && isNullableTimestamp(data.get('acceptedAt', null))
        && isNullableTimestamp(data.get('rejectedAt', null))
        && isNullableTimestamp(data.get('expiredAt', null))
        && isNullableTimestamp(data.get('statusUpdatedAt', null));
    }

    // Debe coincidir MANUALMENTE con STATUS_TRANSITIONS de
    // src/utils/quoteStatus.js — tests/rules/quote-status-transitions.test.mjs
    // importa esa tabla real y prueba cada transición contra estas reglas
    // para detectar una eventual desincronización entre ambos lados.
    // 'paid' es terminal (sin salidas); 'accepted' -> 'paid' se mantiene por
    // compatibilidad hasta que exista jobs.paymentStatus.
    function isAllowedStatusTransition(from, to) {
      return (from == 'draft'    && to == 'sent')
        || (from == 'sent'     && to == 'draft')
        || (from == 'sent'     && to == 'accepted')
        || (from == 'sent'     && to == 'rejected')
        || (from == 'sent'     && to == 'expired')
        || (from == 'accepted' && to == 'rejected')
        || (from == 'accepted' && to == 'paid')
        || (from == 'rejected' && to == 'accepted')
        || (from == 'expired'  && to == 'sent');
    }

    // ¿Este campo de fecha puede cambiar en este write? Solo si ES la fecha
    // del estado al que se está transicionando ahora mismo (dateField) — y
    // en ese caso, solo de null a request.time (primera vez). Cualquier otro
    // campo de fecha, o esta misma fecha fuera de esa transición puntual,
    // debe permanecer EXACTAMENTE igual. Esto es lo que impide modificar a
    // mano una fecha ajena al cambio de estado en curso, y también impide
    // tocar cualquier fecha en una edición de contenido normal (dateField
    // es null cuando el status no cambia).
    function trackingDateFieldOk(fieldName, dateField, before, after) {
      return fieldName == dateField
        ? (before.get(fieldName, null) == null
            ? after.get(fieldName, null) == request.time
            : after.get(fieldName, null) == before.get(fieldName, null))
        : after.get(fieldName, null) == before.get(fieldName, null);
    }

    // Protege las 4 fechas de seguimiento en CUALQUIER update (cambie o no
    // el status) — ver trackingDateFieldOk.
    function trackingDatesProtected() {
      let before = resource.data;
      let after  = request.resource.data;
      let dateField = before.status != after.status ? trackingDateForStatus(after.status) : null;

      return trackingDateFieldOk('sentAt', dateField, before, after)
        && trackingDateFieldOk('acceptedAt', dateField, before, after)
        && trackingDateFieldOk('rejectedAt', dateField, before, after)
        && trackingDateFieldOk('expiredAt', dateField, before, after);
    }

    // statusUpdatedAt solo puede cambiar (a request.time) cuando status
    // cambia. Si status no cambia, statusUpdatedAt tampoco debe tocarse.
    function statusUpdatedAtOk() {
      let before = resource.data;
      let after  = request.resource.data;
      return before.status != after.status
        ? after.get('statusUpdatedAt', null) == request.time
        : after.get('statusUpdatedAt', null) == before.get('statusUpdatedAt', null);
    }

    // La transición (resource.data.status -> request.resource.data.status)
    // debe pertenecer a la tabla permitida.
    function isValidStatusChange() {
      return isAllowedStatusTransition(resource.data.status, request.resource.data.status);
    }

    // Incremento válido de contador, ligado a la creación de UN presupuesto.
    function isValidQuoteCounterIncrement() {
      let before = resource.data;
      let after  = request.resource.data;
      let changed = after.diff(before).affectedKeys();

      let onlyUsageFields = changed.hasOnly(usageFields());
      let beforeCount = effectiveQuotesThisMonth(before);
      let limit = before.get('quoteLimit', demoQuoteLimitDefault());
      let pro = isProActive(before);
      let notSuspended = before.get('enabled', true) == true;

      let seqOk = after.lastQuoteNumber == before.get('lastQuoteNumber', 0) + 1
               && after.totalQuotes    == before.get('totalQuotes', 0) + 1;

      // Pro activo: los contadores mensuales NO deben tocarse.
      let proOk = pro && !changed.hasAny(['quotesThisMonth','quoteMonth']);

      // No-Pro: debe respetar el límite ANTES de este write, y sumar exactamente 1.
      let demoOk = !pro
        && beforeCount < limit
        && after.quotesThisMonth == beforeCount + 1
        && after.quoteMonth == currentYearMonth();

      return onlyUsageFields && seqOk && notSuspended && (proOk || demoOk);
    }

    // Carve-out NARROW para _normalizeUserOnLogin (auth.service.js): inicializa
    // a 0 SOLO si los campos no existen todavía. No exige enabled a propósito —
    // un usuario suspendido puede seguir logueándose y viendo sus datos.
    function isValidFirstTimeCounterInit() {
      let before = resource.data;
      let after  = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['quotesThisMonth','quoteMonth','totalQuotes'])
        && !('quotesThisMonth' in before) && !('quoteMonth' in before) && !('totalQuotes' in before)
        && after.quotesThisMonth == 0 && after.totalQuotes == 0
        && after.quoteMonth == currentYearMonth();
    }

    // ── users/{uid} ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || isAdmin());

      // Alta de cuenta: allowlist estricta de campos + tipo + valor exacto de
      // cada uno. Un usuario nuevo solo puede nacer como Demo limpio, sin
      // privilegios ni contadores pre-cargados.
      allow create: if isSignedIn() && isOwner(uid)
        && request.auth.token.email_verified == false
        && request.resource.data.keys().hasOnly(createFieldsAllowed())
        && request.resource.data.keys().hasAll(createFieldsAllowed())
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.onboardingComplete is bool
        && request.resource.data.onboardingComplete == false
        && request.resource.data.lastQuoteNumber is int
        && request.resource.data.lastQuoteNumber == 0
        && request.resource.data.planType is string
        && request.resource.data.planType == 'demo'
        && request.resource.data.pro is bool
        && request.resource.data.pro == false
        && request.resource.data.enabled is bool
        && request.resource.data.enabled == true
        && request.resource.data.quoteLimit is int
        && request.resource.data.quoteLimit == demoQuoteLimitDefault()
        && request.resource.data.quotesThisMonth is int
        && request.resource.data.quotesThisMonth == 0
        && request.resource.data.quoteMonth is string
        && request.resource.data.quoteMonth == currentYearMonth()
        && request.resource.data.totalQuotes is int
        && request.resource.data.totalQuotes == 0;

      // Admin: solo puede tocar planFields — ni perfil, ni contadores, ni
      // borrarlos vía un set() sin merge (affectedKeys() detecta también las
      // claves eliminadas, no solo las agregadas/cambiadas).
      allow update: if isSignedIn() && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(planFields());

      // Dueño: tres caminos, ninguno puede tocar planFields.
      allow update: if isVerified() && isOwner(uid)
        && resource.data.get('deletionPending', false) == false && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields())
        || isValidQuoteCounterIncrement()
        || isValidFirstTimeCounterInit()
      );

      // El dueño puede borrar su propio doc — lo usa deleteCurrentUserAccount()
      // (auth.service.js) al eliminar la cuenta. La v3 original de esta regla
      // dividió el "allow write" heredado en create/update y omitió delete por
      // error — sin esto, borrar la cuenta queda roto en producción.
      allow delete: if isVerified() && isOwner(uid);
    }

    // Perfil privado del negocio. El documento tiene como ID el UID del dueño.
    // Se admite merge:true porque la app actualiza el logo por separado.
    match /businessProfiles/{uid} {
      allow read: if isVerified() && isOwner(uid);
      allow create, update: if accountAllowsWrites() && isOwner(uid)
        && businessProfileValid(request.resource.data);
      allow delete: if isVerified() && isOwner(uid);
    }

    // ── quotes/{quoteId} ────────────────────────────────────────────────────
    match /quotes/{quoteId} {
      allow read: if isVerified() && resource.data.userId == request.auth.uid;

      // ID determinista ${uid}_${quoteNumber}: un batch/transacción solo admite
      // una escritura por documento, así que como máximo hay un incremento
      // válido de lastQuoteNumber por commit — eso limita a un único quoteId
      // válido por commit, cerrando la posibilidad de crear varios quotes con
      // un solo incremento de contador.
      allow create: if accountAllowsWrites()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.quoteNumber is int
        && request.resource.data.quoteNumber > 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && trackingDatesValid(request.resource.data)
        // clientId es opcional (cliente ocasional = null); si no es null,
        // debe referenciar un cliente propio existente.
        && (request.resource.data.get('clientId', null) == null
            || referencesOwnClient(request.resource.data.clientId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('enabled', true) == true
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastQuoteNumber ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('lastQuoteNumber', 0) + 1
        && request.resource.data.quoteNumber ==
             getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastQuoteNumber
        && quoteId == request.auth.uid + '_' + string(request.resource.data.quoteNumber);

      // Inmutabilidad de userId/quoteNumber/createdAt + enum cerrado de status.
      // 'paid' se mantiene por compatibilidad con la funcionalidad actual —
      // se migrará a jobs.paymentStatus cuando exista la colección jobs;
      // isAllowedStatusTransition no tiene ninguna entrada con from == 'paid',
      // así que queda terminal (sin salidas) automáticamente.
      //
      // Si status cambia, debe ser una transición permitida Y respetar
      // trackingDatesProtected/statusUpdatedAtOk (fechas de seguimiento).
      // Si status NO cambia, la edición de contenido queda libre como
      // siempre — pero trackingDatesProtected() igual exige que las 4
      // fechas de seguimiento permanezcan EXACTAMENTE iguales (no hay
      // transición en curso, así que ninguna puede tocarse), y
      // statusUpdatedAtOk() exige lo mismo para esa fecha.
      //
      // clientId: si no cambia, no se re-valida (permite seguir editando un
      // presupuesto cuyo cliente fue archivado o incluso borrado, sin quedar
      // bloqueado). Si cambia, el nuevo valor debe ser null o referenciar un
      // cliente propio.
      allow update: if accountAllowsWrites()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.quoteNumber == resource.data.quoteNumber
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['draft','sent','accepted','rejected','paid','expired']
        && trackingDatesValid(request.resource.data)
        && trackingDatesProtected()
        && statusUpdatedAtOk()
        && (
          request.resource.data.status == resource.data.status
          || isValidStatusChange()
        )
        && (
          request.resource.data.get('clientId', null) == resource.data.get('clientId', null)
          || request.resource.data.get('clientId', null) == null
          || referencesOwnClient(request.resource.data.clientId)
        )
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('enabled', true) == true;

      allow delete: if accountAllowsWrites() && resource.data.userId == request.auth.uid;
    }

    // ── clients/{clientId} ──────────────────────────────────────────────────
    // Acceso restringido al usuario dueño. No lleva el mismo nivel de rigor
    // que users/quotes (getAfter, transacciones) porque nada acá gatea un
    // límite de plan ni un valor monetario — es una ficha de contacto.
    match /clients/{clientId} {
      allow read: if isVerified() && resource.data.userId == request.auth.uid;

      allow create: if accountAllowsWrites()
        && request.resource.data.keys().hasOnly(clientFieldsAllowed())
        && request.resource.data.keys().hasAll(clientFieldsAllowed())
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && isNullableString(request.resource.data.phone)
        && isNullableString(request.resource.data.email)
        && isNullableString(request.resource.data.address)
        && isNullableString(request.resource.data.notes)
        && request.resource.data.archived is bool && request.resource.data.archived == false
        && (request.resource.data.archivedAt == null || request.resource.data.archivedAt is timestamp)
        && request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time;

      // Cubre tanto una edición completa del formulario como un archivar/
      // restaurar parcial: request.resource.data siempre refleja el documento
      // COMPLETO resultante (los campos no tocados por este write se
      // mantienen), así que la misma validación exhaustiva sirve para ambos
      // casos sin necesitar una rama aparte.
      allow update: if accountAllowsWrites()
        && resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(clientFieldsAllowed())
        && request.resource.data.keys().hasAll(clientFieldsAllowed())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && isNullableString(request.resource.data.phone)
        && isNullableString(request.resource.data.email)
        && isNullableString(request.resource.data.address)
        && isNullableString(request.resource.data.notes)
        && request.resource.data.archived is bool
        && (request.resource.data.archivedAt == null || request.resource.data.archivedAt is timestamp)
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time;

      // La app NO expone ningún botón de "borrar cliente" — la UI solo ofrece
      // archivar/restaurar (ver ClientListScreen/ClientDetailScreen). Esta
      // regla permite el borrado al dueño solo para que
      // deleteCurrentUserAccount() (auth.service.js) pueda limpiar los
      // clientes del usuario al eliminar la cuenta, mismo criterio que ya
      // aplica a quotes/templates. No hay ninguna forma de disparar esto
      // desde la interfaz salvo eliminando la cuenta entera.
      allow delete: if accountAllowsWrites() && resource.data.userId == request.auth.uid;
    }

    // ── templates/{templateId} ─────────────────────────────────────────────
    // Acceso restringido al usuario dueño de la plantilla.
    match /templates/{templateId} {
      allow read:   if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if accountAllowsWrites() && request.resource.data.userId == request.auth.uid;
      allow update: if accountAllowsWrites() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if accountAllowsWrites() && resource.data.userId == request.auth.uid;
    }

    // ── admins/{uid} ────────────────────────────────────────────────────────
    // Solo lectura para usuarios autenticados. Escritura solo desde la consola.
    match /admins/{uid} {
      allow read:  if isVerified();
      allow write: if false;
    }

    // ── appConfig/{docId} ───────────────────────────────────────────────────
    // Info no sensible (versión mínima, aviso de actualización). Lectura pública.
    match /appConfig/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }
  }
}
