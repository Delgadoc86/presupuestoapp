# Entorno visible en Sentry/EAS: development, preview o production.
EXPO_PUBLIC_APP_ENV=development

# Configuración web pública de Firebase. Deben definirse las seis o ninguna.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional. Sin DSN, el monitoreo queda desactivado y la app funciona igual.
EXPO_PUBLIC_SENTRY_DSN=

# Opcionales para subir source maps. No llevan prefijo EXPO_PUBLIC.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
